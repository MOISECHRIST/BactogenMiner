/*
Define parameters
*/
params{
    samplesheet = "test/sample-sheet.csv"
    max_cpus = "${Runtime.runtime.availableProcessors() - 2}".toInteger()
    max_mem = "${((java.lang.management.ManagementFactory.getOperatingSystemMXBean().totalMemorySize) / (1024**3) - 2)}.GB"
    kraken_db = "test/xxxx" //to be completed 
    bracken_class_level = 'S'
    kraken_read_len = '100'
    bracken_threshold = '0'
    mlst_scheme = null
}

/*
Profile 
*/
profiles {
    docker {
        docker.enabled = true
        docker.fixOwnership = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
    }

    conda {
        conda.enabled = true
    }

    test {
        params.samplesheet = "${projectDir}/test/sample_sheet.csv"
    }
}

/*
process
*/
process{
    //Names
    withName: FASTQC{
        conda = "${projectDir}/envs/quality_control.yml"
        container = "quay.io/biocontainers/fastqc:0.11.2--pl5.22.0_0"
    }
    withName: FASTP{
        conda = "${projectDir}/envs/quality_control.yml"
        container = "quay.io/biocontainers/fastp:1.3.6--h43da1c4_0"
    }
    withName: SPADES{
        conda = "${projectDir}/envs/spades.yml"
        container = "quay.io/biocontainers/spades:4.3.0--hde4eca7_1"
    }
    withName: BANDAGE{
        conda = "${projectDir}/envs/assemby_qc.yml"
        container = "quay.io/biocontainers/bandage:0.8.1--h30c83c5_1"
    }
    withName: QUAST{
        conda = "${projectDir}/envs/assemby_qc.yml"
        container = "quay.io/biocontainers/quast:5.3.0--py313pl5321h5ca1c30_2"
    }
    withName: KRAKEN2{
        conda = "${projectDir}/envs/kraken2_bracken.yml"
        container = "quay.io/biocontainers/kraken2:2.17.1--pl5321h077b44d_0"
    }
    withName: BRACKEN{
        conda = "${projectDir}/envs/kraken2_bracken.yml"
        container = "quay.io/biocontainers/bracken:3.1p1--hc52dbad_0"
    }
    withName: MLST{
        conda = "${projectDir}/envs/mlst_env.yml"
        container = "quay.io/biocontainers/mlst:2.9--pl5.22.0_0"
    }

    
    //Labels
    withLabel: 'low' {
        cpus = 2
        memory = 2.GB
    }
    withLabel: 'high'{
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = params.max_mem
    }
}

/*
Outputs setting
*/
outputDir = "results"
workflow.output.mode = "copy"