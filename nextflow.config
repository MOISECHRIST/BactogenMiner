/*
Define parameters
*/
params {
    // mandatory
    max_cpus = Math.max(1, Runtime.runtime.availableProcessors() - 2)
    max_mem = 28.GB
    bracken_class_level = 'S'
    kraken_read_len = '100'
    bracken_threshold = '0'
    outdir = 'results'
    mlst_scheme = null
    busco_lineage = 'bacteria_odb12'

    // elective
    // bloc 1
    reads = null
    samplesheet_csv = null
    sample_name = 'sample01'
    // bloc 2
    use_kraken2 = false
    kraken_db = null
    // bloc 3
    use_gambit = true
    gambit_db = null
    // bloc 4
    use_bakta = false
    bakta_db_type = 'full' //[light|full]
    bakta_db = null
}

/*
Profiles 
*/
profiles {
    docker {
        docker.enabled = true
        docker.fixOwnership = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    conda {
        conda.enabled = true
    }

    test {
        params.samplesheet = "${projectDir}/test/data/sample_sheet.csv"
    }

    using_kraken2 {
        params.use_kraken2 = true 
        params.kraken_db = "${projectDir}/test/references/k2_standard_08_GB_20260626"
        params.use_gambit = false
    }

    using_gambit {
        params.use_gambit = true
        params.gambit_db = "${projectDir}/test/references/gambit"
        params.use_kraken2 = false
    }
}

/*
Processes
*/
process {
    // Names
    withName: FASTQC {
        conda = "${projectDir}/envs/quality_control.yml"
        container = "quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0"
    }
    withName: FASTP {
        conda = "${projectDir}/envs/quality_control.yml"
        container = "quay.io/biocontainers/fastp:1.3.6--h43da1c4_0"
    }
    withName: SPADES {
        conda = "${projectDir}/envs/spades.yml"
        container = "quay.io/biocontainers/spades:4.3.0--hde4eca7_1"
    }
    withName: BANDAGE {
        conda = "${projectDir}/envs/assemby_qc.yml"
        container = "quay.io/biocontainers/bandage:0.8.1--h30c83c5_1"
    }
    withName: QUAST {
        conda = "${projectDir}/envs/assemby_qc.yml"
        container = "quay.io/biocontainers/quast:5.3.0--py313pl5321h5ca1c30_2"
    }
    withName: KRAKEN2 {
        conda = "${projectDir}/envs/kraken2_bracken.yml"
        container = "quay.io/biocontainers/kraken2:2.17.1--pl5321h077b44d_0"
    }
    withName: BRACKEN {
        conda = "${projectDir}/envs/kraken2_bracken.yml"
        container = "quay.io/biocontainers/bracken:3.1p1--hc52dbad_0"
    }
    withName: MLST {
        conda = "${projectDir}/envs/mlst_env.yml"
        container = "quay.io/biocontainers/mlst:2.9--pl5.22.0_0"
    }
    withName: BUSCO {
        conda = "${projectDir}/envs/assemby_qc.yml"
        container = "quay.io/biocontainers/busco:6.1.0--pyhdfd78af_0"
    }
    /*
    withName: MASH {
        conda = "${projectDir}/envs/mash_env.yml"
        container = "quay.io/biocontainers/mash:2.3--hf85e966_11"
    }
    */
    withName: GAMBIT {
        conda = "${projectDir}/envs/gambit_env.yml"
        container = "quay.io/biocontainers/gambit:1.2.0--py310h6813faf_0"
    }
    withName: PROKKA {
        conda = "${projectDir}/envs/prokka_env.yml"
        container = "quay.io/biocontainers/prokka:1.15.6--pl5321hdfd78af_0"
    }
    withName: BAKTA {
        conda = "${projectDir}/envs/bakta_env.yml"
        container = "quay.io/biocontainers/bakta:1.9.4--pyhdfd78af_0"
    }
    withName: BAKTA_BD {
        conda = "${projectDir}/envs/bakta_env.yml"
        container = "quay.io/biocontainers/bakta:1.9.4--pyhdfd78af_0"
    }
    withName: ABRICATE {
        conda = "${projectDir}/envs/abricate_env.yml"
        container = "quay.io/biocontainers/abricate:1.4.0--h05cac1d_0"
    }

    // Labels
    withLabel: 'low' {
        cpus = 2
        memory = 2.GB
    }
    withLabel: 'high' {
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = params.max_mem
    }
}

outputDir = params.outdir